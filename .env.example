# Copier ce fichier en .env puis remplir les deux valeurs.
# Le fichier .env est ignore par git, il ne partira jamais sur GitHub.

# Intervals.icu > Settings > Developer Settings > API Key
INTERVALS_API_KEY=

# Ton identifiant athlete Intervals.icu, de la forme i123456.
# Visible dans l'URL quand tu es connecte : intervals.icu/athlete/i123456/...
INTERVALS_ATHLETE_ID=
